  "tokenColors": [
    {
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": ["comment", "comment.line", "comment.block", "comment.block.documentation"],
      "settings": { "foreground": "#404040", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "keyword.control", "keyword.operator.word", "keyword.other", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#840058" }
    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#840058" }
    },
    {
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string", "string.regexp"],
      "settings": { "foreground": "#004f00" }
    },
    {
      "scope": ["constant.character.escape", "constant.other.placeholder"],
      "settings": { "foreground": "#6b3500" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"],
      "settings": { "foreground": "#6b3500" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#6b3500" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call", "entity.name.method"],
      "settings": { "foreground": "#0016da" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.class", "support.type"],
      "settings": { "foreground": "#7b27b0" }
    },
    {
      "scope": ["variable.other.property", "variable.other.member", "support.variable", "variable.other.object.property"],
      "settings": { "foreground": "#262626" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#6b3500" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#840058" }
    },
    {
      "scope": ["punctuation", "punctuation.definition.tag", "punctuation.separator", "punctuation.terminator", "meta.brace"],
      "settings": { "foreground": "#000000" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#840058", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#6b3500", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#660099", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#404040", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.raw", "markup.inline.raw"],
      "settings": { "foreground": "#004f00" }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#0016da" }
    },
    {
      "scope": ["markup.inserted", "diff.inserted"],
      "settings": { "foreground": "#004f00" }
    },
    {
      "scope": ["markup.deleted", "diff.deleted"],
      "settings": { "foreground": "#890c07" }
    },
    {
      "scope": ["markup.changed", "diff.changed"],
      "settings": { "foreground": "#0016da" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#890c07", "fontStyle": "underline" }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#404040", "fontStyle": "strikethrough" }
    }
  ]
}
