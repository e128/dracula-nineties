{
  "name": "Dracula-Nineties Light",
  "dark": false,
  "author": "the maintainer",
  "editorScheme": "/dracula-nineties-light.xml",

  "colors": {
    "surface": "#c0c0c0",
    "surfaceAlt": "#b0b0b0",
    "codeBg": "#d4d0c8",
    "onSurface": "#000000",
    "label": "#262626",
    "muted": "#404040",
    "ruleLight": "#606060",
    "rule": "#a3a3a3",
    "hover": "#adadad",
    "pressed": "#9a9a9a",
    "selection": "#ebe7df",
    "selectionSoft": "#969bca",
    "link": "#0019ee",
    "orange": "#804000",
    "red": "#ac130c",
    "purple": "#660099",
    "pink": "#8b005c",
    "green": "#005500",
    "data1": "#0019ee",
    "data2": "#8b005c",
    "data3": "#005500",
    "data4": "#5a4a00"
  },

  "ui": {
    "*": {
      "background": "surface",
      "foreground": "onSurface",
      "infoForeground": "muted",
      "disabledForeground": "ruleLight",
      "disabledText": "ruleLight",
      "disabledBackground": "surfaceAlt",
      "inactiveForeground": "muted",
      "inactiveBackground": "surface",
      "selectionBackground": "selection",
      "selectionForeground": "onSurface",
      "selectionInactiveBackground": "codeBg",
      "selectionInactiveForeground": "onSurface",
      "selectionBackgroundInactive": "codeBg",
      "selectionForegroundInactive": "onSurface",
      "hoverBackground": "hover",
      "pressedBackground": "pressed",
      "borderColor": "rule",
      "separatorColor": "rule",
      "lineSeparatorColor": "rule",
      "acceleratorForeground": "muted",
      "acceleratorSelectionForeground": "onSurface",
      "focusColor": "link",
      "focusedBorderColor": "link",
      "focusedColor": "link",
      "caretForeground": "pink",
      "errorForeground": "red"
    },

    "Borders": {
      "color": "rule",
      "ContrastBorderColor": "rule"
    },

    "Button": {
      "startBackground": "codeBg",
      "endBackground": "codeBg",
      "startBorderColor": "ruleLight",
      "endBorderColor": "ruleLight",
      "foreground": "onSurface",
      "disabledBorderColor": "rule",
      "focusedBorderColor": "link",
      "default": {
        "startBackground": "#ae9ab8",
        "endBackground": "#ae9ab8",
        "startBorderColor": "purple",
        "endBorderColor": "purple",
        "foreground": "onSurface",
        "focusColor": "link",
        "focusedBorderColor": "link"
      }
    },

    "Component": {
      "borderColor": "ruleLight",
      "focusedBorderColor": "link",
      "disabledBorderColor": "rule",
      "focusColor": "link",
      "errorFocusColor": "red",
      "inactiveErrorFocusColor": "#ba908e",
      "warningFocusColor": "orange",
      "inactiveWarningFocusColor": "#ae9c8a",
      "infoForeground": "muted"
    },

    "CheckBox": {
      "background": "surface",
      "foreground": "onSurface"
    },

    "ComboBox": {
      "background": "codeBg",
      "nonEditableBackground": "codeBg",
      "ArrowButton": {
        "background": "codeBg",
        "nonEditableBackground": "codeBg",
        "iconColor": "label",
        "disabledIconColor": "ruleLight"
      },
      "selectionBackground": "selection",
      "selectionForeground": "onSurface"
    },

    "TextField": { "background": "codeBg", "foreground": "onSurface", "caretForeground": "pink" },
    "PasswordField": { "background": "codeBg", "foreground": "onSurface" },
    "TextArea": { "background": "codeBg", "foreground": "onSurface" },
    "FormattedTextField": { "background": "codeBg", "foreground": "onSurface" },
    "SearchField": { "background": "codeBg" },
    "SearchMatch": { "startBackground": "#aa937d", "endBackground": "#aa937d" },

    "Editor": {
      "background": "surface",
      "foreground": "onSurface",
      "shortcutForeground": "link",
      "SearchField": { "background": "codeBg" },
      "Toolbar": { "borderColor": "rule" }
    },

    "EditorTabs": {
      "background": "surfaceAlt",
      "inactiveUnderlineColor": "ruleLight",
      "underlineColor": "pink",
      "underlineHeight": 2,
      "underlinedTabBackground": "surface",
      "underlinedTabForeground": "onSurface",
      "hoverBackground": "hover",
      "borderColor": "rule"
    },

    "DefaultTabs": {
      "background": "surfaceAlt",
      "underlineColor": "pink",
      "inactiveUnderlineColor": "ruleLight",
      "underlinedTabBackground": "surface",
      "underlinedTabForeground": "onSurface",
      "hoverBackground": "hover",
      "borderColor": "rule"
    },

    "TabbedPane": {
      "background": "surfaceAlt",
      "focusColor": "pink",
      "underlineColor": "pink",
      "contentAreaColor": "rule",
      "hoverColor": "hover",
      "disabledUnderlineColor": "ruleLight"
    },

    "ToolWindow": {
      "Background": "surfaceAlt",
      "Button": {
        "hoverBackground": "hover",
        "selectedBackground": "codeBg",
        "selectedForeground": "onSurface"
      },
      "Header": {
        "background": "surfaceAlt",
        "inactiveBackground": "surfaceAlt",
        "borderColor": "rule"
      },
      "HeaderTab": {
        "underlineColor": "pink",
        "inactiveUnderlineColor": "ruleLight",
        "underlinedTabBackground": "surfaceAlt",
        "underlinedTabForeground": "onSurface",
        "hoverBackground": "hover"
      }
    },

    "Tree": {
      "background": "surfaceAlt",
      "foreground": "onSurface",
      "rowHeight": 22,
      "hash": "rule",
      "selectionBackground": "selection",
      "selectionForeground": "onSurface",
      "selectionInactiveBackground": "codeBg",
      "modifiedItemForeground": "data1"
    },

    "Table": {
      "background": "surfaceAlt",
      "foreground": "onSurface",
      "gridColor": "rule",
      "stripeColor": "surface",
      "lightSelectionBackground": "codeBg",
      "selectionBackground": "selection",
      "selectionForeground": "onSurface",
      "focusCellBackground": "selection",
      "sortIconColor": "label"
    },
    "TableHeader": {
      "background": "surfaceAlt",
      "foreground": "pink",
      "bottomSeparatorColor": "ruleLight",
      "cellBorder": "rule",
      "separatorColor": "rule"
    },

    "List": {
      "background": "surfaceAlt",
      "foreground": "onSurface",
      "selectionBackground": "selection",
      "selectionForeground": "onSurface",
      "selectionInactiveBackground": "codeBg",
      "hoverBackground": "hover"
    },

    "Menu": { "background": "codeBg", "foreground": "onSurface", "borderColor": "rule", "separatorColor": "rule" },
    "MenuBar": { "background": "surfaceAlt", "foreground": "onSurface", "borderColor": "rule" },
    "MenuItem": {
      "background": "codeBg",
      "foreground": "onSurface",
      "selectionBackground": "selection",
      "selectionForeground": "onSurface",
      "acceleratorForeground": "muted",
      "disabledForeground": "ruleLight"
    },
    "PopupMenu": { "background": "codeBg", "borderColor": "rule" },
