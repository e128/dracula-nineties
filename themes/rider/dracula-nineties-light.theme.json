    "ActionButton": {
      "hoverBackground": "hover",
      "hoverBorderColor": "hover",
      "pressedBackground": "pressed",
      "pressedBorderColor": "pressed"
    },

    "SegmentedButton": {
      "selectedButtonColor": "codeBg",
      "selectedStartBorderColor": "ruleLight",
      "selectedEndBorderColor": "ruleLight",
      "focusedSelectedButtonColor": "selection"
    },

    "Slider": { "background": "surface", "trackColor": "codeBg", "thumbColor": "purple", "tickColor": "ruleLight" },
    "Spinner": { "background": "codeBg" },

    "TitlePane": { "background": "surfaceAlt", "inactiveBackground": "surfaceAlt", "infoForeground": "muted" },

    "WelcomeScreen": {
      "background": "surface",
      "borderColor": "rule",
      "separatorColor": "rule",
      "SidePanel": { "background": "surfaceAlt" },
      "Projects": {
        "background": "surface",
        "selectionBackground": "selection",
        "selectionInactiveBackground": "codeBg",
        "actions": { "background": "surface", "selectionBackground": "selection" }
      }
    },

    "FileColor": {
      "Blue": "#adafc5",
      "Green": "#adb5ad",
      "Orange": "#bab3ad",
      "Yellow": "#b6b4ad",
      "Rose": "#beafae",
      "Violet": "#b7adbc",
      "Gray": "#b4b4b4"
    },

    "VersionControl": {
      "FileHistory": {
        "Commit": {
