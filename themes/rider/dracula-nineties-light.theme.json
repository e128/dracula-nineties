      "Actions.Red": "#ac130c",
      "Actions.Yellow": "#804000",
      "Actions.Green": "#005500",
      "Actions.Blue": "#0019ee",
      "Actions.Grey": "#262626",
      "Actions.GreyInline": "#404040",
      "Actions.GreyInline.Dark": "#404040",
      "Objects.Grey": "#404040",
      "Objects.RedStatus": "#ac130c",
      "Objects.Red": "#ac130c",
      "Objects.Pink": "#8b005c",
      "Objects.Yellow": "#5a4a00",
      "Objects.YellowDark": "#804000",
      "Objects.Green": "#005500",
      "Objects.GreenAndroid": "#005500",
      "Objects.Blue": "#0019ee",
      "Objects.Purple": "#660099",
      "Objects.BlackText": "#c0c0c0",
      "Checkbox.Background.Default": "#d4d0c8",
      "Checkbox.Background.Selected": "#660099",
      "Checkbox.Border.Default": "#606060",
      "Checkbox.Border.Selected": "#660099",
      "Checkbox.Foreground.Selected": "#c0c0c0",
      "Checkbox.Focus.Thin.Default": "#0019ee",
      "Checkbox.Focus.Thin.Selected": "#0019ee",
      "Checkbox.Focus.Wide": "#0019ee",
      "Checkbox.Background.Disabled": "#b0b0b0",
      "Checkbox.Border.Disabled": "#a3a3a3",
      "Checkbox.Foreground.Disabled": "#606060",
      "Tree.iconColor": "#262626"
