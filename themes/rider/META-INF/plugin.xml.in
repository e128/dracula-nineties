<idea-plugin>
  <id>com.e128.dracula-nineties</id>
  <name>Dracula-Nineties</name>
  <version>{{version}}</version>
  <vendor>e128</vendor>

  <description><![CDATA[
    Dark and light UI themes and editor colour schemes derived from the Dracula-Nineties
    HTML template. Every colour is the sRGB rendering of a
    <code>dracula-nineties.css</code> <code>:root</code> <code>oklch()</code> token, dark
    from the base palette and light from its <code>prefers-color-scheme: light</code>
    override.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <idea-version since-build="223" />

  <extensions defaultExtensionNs="com.intellij">
    <themeProvider id="com.e128.dracula-nineties" path="/dracula-nineties.theme.json" />
    <themeProvider id="com.e128.dracula-nineties-light" path="/dracula-nineties-light.theme.json" />
  </extensions>
</idea-plugin>
